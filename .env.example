# Шаблон переменных окружения. Приложение не читает .env автоматически.
NEO4J_URI=neo4j+s://your-server
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Необязательно для просмотра и ручных правок. Нужно для анализа текста.
OPENAI_API_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
# Уровень reasoning для всех вызовов: low | medium | high (по умолчанию не отправляется).
# LLM_REASONING_EFFORT=

# Отдельная модель для извлечения сущностей; без неё используется LLM_MODEL.
# LLM_EXTRACTION_MODEL=
# Reasoning для извлечения сущностей (по умолчанию low).
# LLM_EXTRACTION_REASONING_EFFORT=

# Своя модель/reasoning на отдельную стадию пайплайна — переменная вида
# LLM_<STAGE>_MODEL / LLM_<STAGE>_REASONING_EFFORT; без неё стадия использует
# LLM_MODEL/LLM_REASONING_EFFORT. Стадии: SCENES, NARRATIVE, NARRATIVE_LINKS,
# CHAPTER_RESOLUTION, BOOK_RESOLUTION, BOOK_RECONCILIATION, AGENT, JUDGE.
# Например, для разбиения главы на сцены (самый первый LLM-вызов пайплайна):
# LLM_SCENES_MODEL=
# LLM_SCENES_REASONING_EFFORT=
# Меняет способ построения сцены на определение STSS (Zehe et al., 2021) с типом сегмента
# (scene/summary/description/reflection). Меняет method_hash сцен: следующая
# подготовка перестроит сцены и всё зависимое от них.
# SCENES_METHOD=stss

# Агент диалога (вызовы инструментов и итоговый ответ); нужна поддержка tool calling.
# LLM_AGENT_MODEL=
# LLM_AGENT_REASONING_EFFORT=
# Проверка найденных фрагментов по критерию.
# LLM_JUDGE_MODEL=
# LLM_JUDGE_REASONING_EFFORT=
# Сколько порций кандидатов проверяется одновременно (1–8, по умолчанию 6).
# JUDGE_WORKERS=6
# Таймаут чтения ответа модели, секунды (по умолчанию 600).
# LLM_TIMEOUT_SECONDS=
# Число одновременно обрабатываемых глав (1–8, по умолчанию 4). Уменьши,
# если провайдер модели ограничивает параллельные запросы.
# BOOK_PREPARATION_WORKERS=4

# Cемантический поиск. Модель эмбеддингов выбирается явно.
# Поддерживается OpenAI-совместимый endpoint /embeddings.
# EMBEDDING_MODEL=
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# Лимит одного входа embedding-модели (text-embedding-3-*: 8191). Более длинная
# сцена эмбеддится окнами, вектор — среднее окон.
# EMBEDDING_MAX_INPUT_TOKENS=8000
